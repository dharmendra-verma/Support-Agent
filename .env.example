# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides
# Agent SDK uses model aliases: sonnet | opus | haiku
AGENT_SDK_MODEL=sonnet
AGENT_MAX_TURNS=25
# Direct Messages API (reference loop / single-shot calls) uses full model ids:
ANTHROPIC_MODEL=claude-sonnet-4-6
